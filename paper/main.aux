\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architectural overview of \textbf  {DARC-Route}. Given user instruction $x$, two complementary prompts (Direct extraction $A$ and Evidence-grounded extraction $B$) yield candidate intents $y_A, y_B$. A shared exact solver computes provisional routes $r_A, r_B$. The decision gate evaluates structural protection $h$ and cross-utility swing $\Delta _U$. Only high-risk samples ($\Delta _U > \tau ^*$) trigger a single evidence-based review ($4.2\%$ of traffic), achieving maximum route stability with minimal compute overhead.}}{2}{}\protected@file@percent }
\newlabel{fig:framework}{{1}{2}{}{figure.1}{}}
