{
  "protocol_version": "darc-v5.1-stress-design-1",
  "scope": "development_only",
  "semantic_groups": 12,
  "utterances_per_group": 4,
  "candidate_gate_calls": 96,
  "strata": {
    "combined_hard_constraints_min_groups": 2,
    "implicit_preference_min_groups": 2,
    "negation_or_concession_min_groups": 2,
    "near_boundary_planning_min_groups": 2,
    "paraphrase_perturbation_groups": 12
  },
  "selection_rule": "sample from development-exposed eligible pool before model calls; never select by method outcome",
  "review_expansion_gate": {
    "minimum_distinct_groups_with_real_a_or_b_error_or_disagreement": 4,
    "schema_failure_counts_as_error": true,
    "within_direction_numeric_weight_difference_alone_counts": false
  },
  "allowed_revision_rounds": 1,
  "allowed_revision_scope": [
    "clarify that the instruction is the final semantic authority",
    "clarify the frozen output schema example"
  ],
  "forbidden_revision_scope": [
    "candidate prompts",
    "gold labels",
    "graphs",
    "method information levels",
    "evaluation thresholds",
    "selection based on DARC outcomes"
  ],
  "paper_gate": "CLOSED"
}
