{
  "provider": "deepseek",
  "model": "deepseek-v4-flash",
  "wire_api": "chat_completions",
  "base_url": "https://api.apilio.ai",
  "api_key_env": "APILIO_API_KEY",
  "temperature": 0.0,
  "omit_temperature": false,
  "timeout": 90,
  "sleep": 0,
  "max_concurrency": 16,
  "retries": 3,
  "retry_sleep": 3,
  "json_mode": true,
  "transport": "curl"
}
